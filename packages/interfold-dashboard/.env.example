# All values are optional — unset ones fall back to the current Sepolia
# deployment (see src/lib/chain.ts). Copy to .env(.local) to override.

# Sepolia RPC endpoint. Defaults to a public node; use a dedicated provider
# (Alchemy/Infura) for production to avoid rate limits.
# VITE_SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/<your-key>

# Contract addresses — point the dashboard at a different deployment.
# VITE_INTERFOLD_ADDRESS=0x670eFE043d1D340148037b4b76c4F9dfED294309
# VITE_CIPHERNODE_REGISTRY_ADDRESS=0x4D707127F72a216EA116AF0B4262dD7382F84259
# VITE_CRISP_PROGRAM_ADDRESS=0xbCc418F4dd1266Cc6070b1e2AC728ef56De946e7

# Bonding registry backing the "Run a ciphernode" guide. The license token,
# ticket wrapper, and ticket underlying are read back from this contract, so
# this is the only address the guide needs.
# VITE_BONDING_REGISTRY_ADDRESS=0x0c25cC9c034611D2F62686e68e61978F21eEc777

# Testnet faucet (FOLD + fee token). Set to the zero address or an empty value to
# hide the "Get test tokens" action — do that for any non-testnet deployment.
# Leaving this line commented out keeps the default Sepolia faucet.
# VITE_FAUCET_ADDRESS=0x94FCD9b624baAf023c7F48C5E7200eAd85dc87Df

# First block to scan from (the Interfold deploy block). Lower = slower initial
# load (more getLogs chunks); set to the actual deploy block of the above.
# VITE_DEPLOY_BLOCK=10939869

# E3 timeout windows (seconds), from the deployment's timeoutConfig. Used to
# decide whether an E3 is still active vs. expired (input close + these windows).
# VITE_COMPUTE_WINDOW=86400
# VITE_DECRYPTION_WINDOW=3600

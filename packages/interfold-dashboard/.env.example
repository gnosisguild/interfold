# All values are optional — unset ones fall back to the current mainnet
# deployment (see src/lib/chain.ts). Copy to .env(.local) to override.

# Ethereum mainnet RPC endpoint. Defaults to a public node; use a dedicated
# provider (Alchemy/Infura) for production to avoid rate limits.
# VITE_MAINNET_RPC=https://eth-mainnet.g.alchemy.com/v2/<your-key>

# Contract addresses — point the dashboard at a different deployment.
# VITE_INTERFOLD_ADDRESS=0x28cF63B459e6218C69EA97ea7D90541cf648c715
# VITE_CIPHERNODE_REGISTRY_ADDRESS=0xC927A5B2d8F68697bC28C0670df05178c93df2d7
# CRISP is not deployed on mainnet yet — the default is the MockE3Program.
# VITE_CRISP_PROGRAM_ADDRESS=0x4976E5E47852eFCe6851d35B95A1A2E19456F3D7

# Bonding registry backing the "Run a ciphernode" guide. The ciphernode bond token,
# ticket wrapper, and ticket underlying are read back from this contract, so
# this is the only address the guide needs.
# VITE_BONDING_REGISTRY_ADDRESS=0x0ec90465095C21830BEcED07e032809A2Bd2915F

# Testnet faucet (FOLD + fee token). There is no faucet on mainnet, so this is
# disabled by default and the "Get test tokens" action is hidden. Set it to a
# faucet address only when pointing the dashboard at a testnet deployment.
# VITE_FAUCET_ADDRESS=

# First block to scan from. It bounds getLogs against Interfold,
# CiphernodeRegistry and CRISPProgram, so set it to the earliest of those three
# deploy blocks — a later value silently drops earlier registry events.
# Lower = slower initial load (more getLogs chunks).
# VITE_DEPLOY_BLOCK=25786403

# E3 timeout windows (seconds), from the deployment's getTimeoutConfig(). Used to
# decide whether an E3 is still active vs. expired (input close + these windows).
# Mainnet: computeWindow 604800 (7 days), decryptionWindow 21600 (6 hours).
# VITE_COMPUTE_WINDOW=604800
# VITE_DECRYPTION_WINDOW=21600
